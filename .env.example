# ═══════════════════════════════════════════════════════════════
# openvibe.run — Environment Configuration
# Copy to .env for development. In production this lives at /etc/openvibe/run.env (0600).
# Names only here; never commit a value.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4920
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4920
TRUST_PROXY=1

# ── Data: PostgreSQL + Valkey (ADR-035) ──────────────────────
# In production OpenVibe.Host writes all four (roles/data/add-service.sh run). Unset in development:
# an embedded PGlite database in data/pglite (one process). Tests need neither.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:run:

# ── Identity: OpenVibe.Network ──────────────────────────────
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
# Optional: pin the Network's RS256 public key (PEM, \n escaped) instead of fetching the JWKS.
#OV_NETWORK_PUBLIC_KEY=
# Audience Run accepts on incoming service tokens; a token must also name a project (project_id).
RUN_AUDIENCE=openvibe.run
OV_OAUTH_CLIENT_ID=run
OV_OAUTH_CLIENT_SECRET=
#COOKIE_SECURE=true

# ── OpenVibe.Events ─────────────────────────────────────────
# Relay of Run's outbox (run.job.*); off when unset (rows wait in run_events_outbox).
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# ── Jobs ────────────────────────────────────────────────────
# Background jobs: the events relay and the dispatcher's poller. RUN_JOBS=off runs the API alone.
#RUN_JOBS=on

# ── Project caps on a job's limits (run.job-create-request@1); over one is 422 run.limits.exceeded ──
#RUN_LIMITS_MAX_WALL_MS=3600000
#RUN_LIMITS_MAX_CPU_MS=3600000
#RUN_LIMITS_MAX_MEM_BYTES=4gb
#RUN_LIMITS_MAX_TTL_MS=86400000
#RUN_LIMITS_MAX_ARGS_BYTES=512kb

# ── The job stream's ticket (a two-minute single-use RS256 compact JWS Run signs) ──
# A PEM in the environment, or a key file. In production with neither set, stream tickets answer 503
# (every other route still serves); in development a key is generated in memory at boot.
#RUN_STREAM_PRIVATE_KEY=
#RUN_STREAM_KEY_FILE=data/keys/run-stream.pem
#RUN_STREAM_KEY_ID=run-stream-1
#RUN_STREAM_TTL_S=120
#RUN_STREAM_RING_BYTES=1mb
#RUN_STREAM_MAX_PER_JOB=64
#RUN_STREAM_HEARTBEAT_MS=25000

# ── The dispatcher bridge to Bot (plan T14 step 6, R1c) ──
# Bot holds the node link and the meter; Run places each job on a node from the Fabric offers and mirrors
# what Bot answers. Needs OV_OAUTH_CLIENT_SECRET above (Run mints its token for audience openvibe.bot);
# without it nothing is sent and every job stays queued.
#RUN_BOT_URL=http://127.0.0.1:4630
#RUN_BOT_AUDIENCE=openvibe.bot
#RUN_POLL_MS=1000
#RUN_DISPATCH_TIMEOUT_MS=8000
# How long the offers Run places from are cached (one read serves a whole tick).
#RUN_OFFERS_TTL_MS=5000
# Polls Bot may answer 404 for a job Run sent before that job fails.
#RUN_DISPATCH_UNKNOWN_POLLS=5
# Jobs one tick places and mirrors; the next tick takes the rest.
#RUN_DISPATCH_MAX_PER_TICK=200

# Run holds no Billing token: Bot owns the node link and the per-second metering (plan T14 L1).
